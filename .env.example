# ============================================================
# PiTavern 环境变量示例（复制为 .env 后填写）
# 每个阶段可独立配置模型；不填的项在启动时自动落到
# faux（脚本假模型），方便无 Key 跑通全链路 Demo。
# ============================================================

# ---- 默认接入：CommandCode（自定义 OpenAI 兼容端点，Key 只存本地）----
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_API_KEY=user_xxx

# 三个阶段默认都用 CommandCode（可改成其它 provider）
PI_ROUTE_PROVIDER=commandcode
PI_ROUTE_MODEL=deepseek/deepseek-v4-flash-fast
PI_ACTOR_PROVIDER=commandcode
PI_ACTOR_MODEL=deepseek/deepseek-v4-flash-fast
PI_EVAL_PROVIDER=commandcode
PI_EVAL_MODEL=deepseek/deepseek-v4-flash-fast

# ---- Redis（阶段 2 卡片仓库 / 阶段 4 结算写回）----
# 留空则使用内存存储回退，Demo 无需 Redis 也能跑
REDIS_URL=redis://127.0.0.1:6379

# ---- 其它 provider 的 API Key（可选，改走这些时用）----
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
